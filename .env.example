# Base URL of the AMS backend API.
REACT_APP_API_URL=https://attsystem-latest.onrender.com

# Data mode:
#   auto  -> try the live API, fall back to bundled demo data if it is unreachable (default)
#   mock  -> always use bundled demo data (offline demo)
#   live  -> always use the live API, never fall back
REACT_APP_DATA_MODE=auto
